{
	"compilerOptions": {
		"outDir": "build/dist",
		"module": "esnext",
		"target": "ES2015",
		"lib": ["es6", "dom"],
		"sourceMap": true,
		"allowJs": true,
		"jsx": "react",
		"moduleResolution": "bundler",
		"rootDir": "src",
		"types": ["node", "webpack-env", "jest"],
		"forceConsistentCasingInFileNames": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"noUnusedLocals": true
	},
	"exclude": ["node_modules", "build", "scripts", "acceptance-tests", "webpack", "jest", "src/setupTests.ts"]
}
